.homepage-hero {
  min-width: 0;
  overflow: hidden;
  grid-area: main;
  position: relative;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0) 40%, rgb(0, 0, 0)) no-repeat top left, url("/hero.jpg") no-repeat top center;
  background-size: cover;
  color: #F2F0F2;
}
.homepage-hero h1 {
  margin: 0 auto 1.5rem;
  font-family: "Pirata One", system-ui;
  font-family: "New Rocker", system-ui;
  font-family: "UnifrakturMaguntia", cursive;
  font-size: 3.2em;
  text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
  font-weight: normal;
  color: #F2F0F2;
}

.hero-content {
  max-width: 100%;
  padding: 15rem 5rem 5rem;
  margin: 0 auto;
}
@media only screen and (max-width: 768px) {
  .hero-content {
    padding: 10rem 1rem 1rem;
  }
}

.hero-carousel {
  position: relative;
  width: 100%;
  padding: 1rem 2rem;
  background: radial-gradient(ellipse, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0) 80%) no-repeat, radial-gradient(ellipse, rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0) 80%) no-repeat;
  background-position: 50% 300%, 50% -100%;
  background-size: 100% 75%, 100% 75%;
}

.hero-carousel-control {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  text-indent: -9999px;
  appearance: none;
  -webkit-appearance: none;
  border: 1px solid #F2F0F2;
  background: #A67280 url("/gfx/arrows.svg") no-repeat center left;
  background-size: auto 24px;
  overflow: hidden;
  width: 64px;
  height: 32px;
  cursor: pointer;
  transition: left 0.2s ease, right 0.2s ease;
}
.hero-carousel-control.hero-carousel-control--back {
  left: -42px;
}
.hero-carousel-control.hero-carousel-control--back:hover {
  left: -48px;
}
.hero-carousel-control.hero-carousel-control--forward {
  right: -42px;
  background-position: center right;
}
.hero-carousel-control.hero-carousel-control--forward:hover {
  right: -48px;
}

.hero-bio {
  background: rgba(0, 0, 0, 0.6);
  margin-top: 1.1rem;
  padding: 1.1rem;
  font-size: 1.2rem;
  max-width: 48rem;
}

.content--periodical .menu {
  padding-bottom: 0;
}

.periodical-front-matter {
  max-width: 100%;
  text-align: center;
  color: #F2F0F2;
  margin-bottom: 1.1rem;
}

.front-matter-title {
  position: relative;
  margin-bottom: 1.1rem;
}
.front-matter-title h1 {
  display: inline-block;
  margin: 0;
  padding: 1.1rem 0.75rem;
  background: url("/gfx/pink_ribbon.jpg") repeat-x left top;
  background-size: auto 100%;
  animation: angel-bob 5s ease infinite;
  animation-delay: 1s;
}
.front-matter-title h1:before, .front-matter-title h1:after {
  position: absolute;
  display: block;
  content: "";
  width: 65px;
  height: 92px;
  top: 0;
  z-index: 1;
}
.front-matter-title h1:before {
  right: 100%;
  background: url("/gfx/cherub_l.gif");
}
.front-matter-title h1:after {
  left: 100%;
  background: url("/gfx/cherub_r.gif");
}

.periodical-grid {
  display: flex;
  min-width: 0;
  max-width: 100%;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: flex-start;
  gap: 0.75rem;
  padding: 0.75rem;
}

.periodical-grid-item {
  position: relative;
  background: rgba(242, 196, 208, 0.6);
  color: #191826;
  width: 16rem;
  min-height: 16rem;
  max-width: 100%;
  padding: 0.75rem;
}
.periodical-grid-item.periodical-grid-item--double {
  width: 32rem;
}
.periodical-grid-item.periodical-grid-item--double .grid-item-title {
  font-size: 2em;
}
.periodical-grid-item.periodical-grid-item--full {
  width: 100%;
}
.periodical-grid-item.periodical-grid-item--full .grid-item-title {
  font-size: 2.8em;
}
.periodical-grid-item.periodical-grid-item--image {
  padding: 0;
  background: transparent;
  overflow: hidden;
  cursor: pointer;
}
.periodical-grid-item.periodical-grid-item--image .grid-item-text-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 20%, rgba(0, 0, 0, 0.4) 80%, rgba(0, 0, 0, 0));
  color: #F2F0F2;
  padding: 1.1rem 0.75rem 0.75rem;
  transition: opacity 0.5s ease, transform 0.5s ease;
}
.periodical-grid-item.periodical-grid-item--image:active .grid-item-text-content {
  opacity: 0;
  transform: translateY(25%);
}
.periodical-grid-item.periodical-grid-item--embed {
  background: transparent;
  padding: 0;
}

.grid-item-title {
  margin: 0 0 0.3rem;
  z-index: 1;
}

@keyframes angel-bob {
  from {
    transform: translateY(-8%);
  }
  50% {
    transform: translateY(8%);
  }
  to {
    transform: translateY(-8%);
  }
}
* {
  box-sizing: border-box;
}

html {
  height: 100%;
}

body {
  height: 100%;
  background: #591E2E url("/gfx/texture_repeating.jpg");
  font-family: "Andada Pro", serif;
  background-size: 125px;
  font-size: 16px;
  color: #191826;
}

p {
  margin: 0 0 1em;
}
p:last-child {
  margin-bottom: 0;
}

.content {
  min-width: 0;
  min-height: 100%;
  display: grid;
  grid-template-areas: "header" "nav" "main" "footer";
  box-sizing: border-box;
}
.content.content--home {
  grid-template-areas: "main" "nav" "footer";
}
.content.content--periodical {
  grid-template-areas: "nav" "header" "main" "footer";
}

nav {
  grid-area: nav;
  min-width: 0;
}

.menu {
  padding: 1rem 0;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
}
.menu li {
  box-sizing: border-box;
  position: relative;
  display: block;
  border: 4px solid #fff;
  border-radius: 1px;
  margin: 0 0 0 36px;
}
.menu li:after, .menu li:before {
  position: absolute;
  display: block;
  content: "";
  height: calc(100% + 4px);
  width: 40px;
  left: 100%;
  top: -4px;
  background: url("/gfx/nav.png") no-repeat left top;
  background-size: cover;
  border: 2px solid #fff;
}
.menu li:last-child {
  margin-right: 40px;
}
.menu li:before {
  left: auto;
  right: 100%;
}
.menu li a {
  display: block;
  font-size: 1.3rem;
  color: #F2F0F2;
  background: transparent;
  margin: 2px;
  border: 2px solid #fff;
  border-radius: 0;
  padding: 0.5rem 0.75rem;
}
.menu li a:visited {
  color: #F2F0F2;
}
.menu li a:active {
  color: #D98484;
}
@media only screen and (max-width: 767px) {
  .menu {
    flex-direction: column;
    justify-items: stretch;
    justify-content: center;
    padding: 0 0.5rem;
    gap: 1.1rem;
  }
  .menu li {
    margin-bottom: 1.1rem;
    margin: 0 36px 0 36px;
  }
}

main {
  min-width: 0;
  grid-area: main;
  margin: 0 5rem 3rem;
  padding: 0.75rem;
  background: rgba(242, 240, 242, 0.6);
}

footer {
  min-width: 0;
  grid-area: footer;
  background: #f2C4D0;
  color: #191826;
  padding: 1.1rem 5rem;
  flex-grow: 1;
  min-height: 8rem;
}
@media only screen and (max-width: 767px) {
  footer {
    padding: 1.1rem;
  }
}

.footer-columns {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.footer-column {
  flex-basis: 12rem;
  text-align: left;
  max-width: 32rem;
  margin-bottom: 1.1rem;
}
.footer-column:last-child {
  flex-grow: 1;
}

.content--home .footer-columns {
  flex-direction: column;
  align-content: center;
}
.content--home .footer-column {
  flex-basis: 100%;
  text-align: center;
}
.content--home .socials {
  justify-content: center;
}

.socials {
  display: flex;
  flex-direction: row;
  gap: 0.75rem;
}
@media only screen and (max-width: 494px) {
  .socials {
    flex-direction: column;
    align-items: center;
  }
}
.socials a {
  display: block;
  width: 3rem;
  height: 3rem;
}

/*# sourceMappingURL=main.css.map */